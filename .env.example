# Copy to .env and fill in. NEVER commit .env. Same names go into Render / Vercel env settings.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# letters, digits, _ and - only (Telegram secret_token rules); long and random
TELEGRAM_WEBHOOK_SECRET=
# Customer Lab "Lab Shopper" bots (1-10); they voice the 10 Lab customers in rotation: [{"token":"..."},{"token":"..."}]
CUSTOMER_BOT_TOKENS=[]
# optional: normally auto-detected when an admin types /lab here in the Customer Lab group
LAB_GROUP_CHAT_ID=
# your Telegram user id(s), comma-separated
ADMIN_TELEGRAM_IDS=

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL_AGENT=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
FORCE_LLM_FAIL=false
# LLM budget guard: tokens per IST day before degrading 70B -> 8B -> rules fallback
LLM_DAILY_TOKENS_AGENT=80000
LLM_DAILY_TOKENS_FAST=400000

# --- App ---
# local default is SQLite; production: Neon connection string (postgresql://...)
DATABASE_URL=sqlite:///./offer_engine.db
ADMIN_PASSCODE=
# public https URL of the backend, e.g. https://offer-engine.onrender.com (webhook auto-registers on boot)
PUBLIC_BASE_URL=
CORS_ORIGINS=http://localhost:5173
TZ=Asia/Kolkata
# time-travel for demos, e.g. 2026-11-06 or 2026-11-06T19:30 (empty = real time)
DEMO_TIME_OVERRIDE=

# --- Frontend (Vercel) ---
VITE_API_URL=http://localhost:8000
VITE_USE_MOCKS=1
